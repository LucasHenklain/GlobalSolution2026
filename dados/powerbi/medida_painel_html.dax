// VigIA — medida única para o visual "HTML Content" do Power BI
// Usa as 5 medidas do kit: [Chuva Acumulada (mm)], [Nível Máximo (% da cota)], [Horas em Alerta],
// [Eventos de Transbordo], [Alertas Emitidos]. Respeita os filtros de estação e de data.
// Cores e estilo copiados do app (mvp/web/static/estilo.css): azul-marinho #0b2a4a, faixa amarela #ffb000,
// cartões brancos com borda #d3dbe6 e cantos de 14px, verde/amarelo/laranja/vermelho dos níveis de risco.
// Como usar: Página Inicial → Nova medida → cole tudo abaixo → arraste a medida para o campo "Values" do HTML Content.

VigIA Painel HTML =
// ---------- números gerais ----------
VAR _chuva   = COALESCE ( [Chuva Acumulada (mm)], 0 )
VAR _nivel   = COALESCE ( [Nível Máximo (% da cota)], 0 )
VAR _horas   = COALESCE ( [Horas em Alerta], 0 )
VAR _eventos = COALESCE ( [Eventos de Transbordo], 0 )
VAR _alertas = COALESCE ( [Alertas Emitidos], 0 )
VAR _prob    = COALESCE ( MAX ( fato_risco[prob_transbordo_60min] ), 0 )
VAR _ini     = MIN ( dim_data[data] )
VAR _fim     = MAX ( dim_data[data] )
VAR _nEst    = COUNTROWS ( VALUES ( dim_estacao[estacao_id] ) )

// ---------- cores (mesmas do app) ----------
VAR _verde = "#1a7f37"
VAR _amarelo = "#a67c00"
VAR _laranja = "#c2410c"
VAR _vermelho = "#b42318"
VAR _chuvaCor = "#4a90d9"
VAR _corNivel =
    SWITCH ( TRUE (), _nivel >= 100, _vermelho, _nivel >= 75, _laranja, _nivel >= 50, _amarelo, _verde )
VAR _corProb =
    SWITCH ( TRUE (), _prob >= 0.5, _vermelho, _prob >= 0.2, _laranja, _verde )

// ---------- texto formatado ----------
VAR _txtPeriodo =
    FORMAT ( _ini, "dd/mm/yyyy" ) & " a " & FORMAT ( _fim, "dd/mm/yyyy" ) & " · "
        & _nEst & IF ( _nEst = 1, " estação", " estações" )
VAR _txtHoras =
    INT ( _horas ) & " h " & FORMAT ( ROUND ( MOD ( _horas * 60, 60 ), 0 ), "00" ) & " min"

// ---------- faixa de situação (igual ao cartão grande do app) ----------
VAR _bannerCor =
    SWITCH ( TRUE (), _eventos > 0, _vermelho, _alertas > 0, _laranja, _nivel >= 50, "#ffd60a", _verde )
VAR _bannerTinta = IF ( _bannerCor = "#ffd60a", "#1b1300", "#ffffff" )
VAR _bannerTitulo =
    SWITCH (
        TRUE (),
        _eventos > 0, "PERIGO: transbordo registrado no período",
        _alertas > 0, "RISCO ALTO: alertas emitidos no período",
        _nivel >= 50, "ATENÇÃO: nível acima da metade da cota",
        "NORMAL: nenhum alerta no período"
    )
VAR _banner =
    "<div style='margin-top:12px;background:" & _bannerCor & ";color:" & _bannerTinta
        & ";border-radius:14px;padding:14px 18px;display:flex;align-items:center;gap:14px'>"
        & "<div style='font-size:34px;font-weight:800;line-height:1'>"
        & IF ( _eventos > 0 || _alertas > 0, "&#9888;", "&#10003;" ) & "</div>"
        & "<div><div style='font-size:20px;font-weight:800'>" & _bannerTitulo & "</div>"
        & "<div style='font-size:13px;opacity:.92'>Maior nível: " & FORMAT ( _nivel, "0.0" )
        & "% da cota de transbordo · Maior chance prevista pela IA: " & FORMAT ( _prob, "0.0%" ) & "</div></div></div>"

// ---------- cartões ----------
VAR _cIni = "<div style='flex:1 1 150px;background:#ffffff;border:1px solid #d3dbe6;border-radius:14px;padding:12px 14px;box-shadow:0 1px 2px rgba(20,33,61,.08),0 6px 18px rgba(20,33,61,.06);border-top:5px solid "
VAR _rot = "'><div style='font-size:12px;font-weight:700;color:#47566e;text-transform:uppercase;letter-spacing:.03em'>"
VAR _val = "</div><div style='font-size:30px;font-weight:800;line-height:1.15;margin-top:4px;color:#14213d'>"
VAR _uni = "<span style='font-size:15px;font-weight:600;color:#47566e'>"
VAR _dica = "</div><div style='font-size:12px;color:#47566e;margin-top:4px'>"
VAR _cFim = "</div></div>"
VAR _cartoes =
    "<div style='display:flex;flex-wrap:wrap;gap:12px;margin-top:12px'>"
        & _cIni & _chuvaCor & _rot & "Chuva acumulada" & _val & FORMAT ( _chuva, "0.0" ) & _uni & " mm</span>"
        & _dica & "média das estações no período" & _cFim
        & _cIni & _corNivel & _rot & "Nível máximo" & _val & FORMAT ( _nivel, "0.0" ) & _uni & " % da cota</span>"
        & _dica & IF ( _nivel >= 100, "passou da cota de transbordo", "abaixo da cota de transbordo" ) & _cFim
        & _cIni & IF ( _horas > 0, _laranja, _verde ) & _rot & "Horas em alerta" & _val & _txtHoras
        & _dica & "tempo com nível em alerta ou transbordo" & _cFim
        & _cIni & IF ( _eventos > 0, _vermelho, _verde ) & _rot & "Transbordos" & _val & _eventos
        & _dica & "eventos em que o córrego transbordou" & _cFim
        & _cIni & IF ( _alertas > 0, _laranja, _verde ) & _rot & "Alertas emitidos" & _val & _alertas
        & _dica & "risco alto e perigo enviados aos moradores" & _cFim
        & _cIni & _corProb & _rot & "Chance máx. (IA)" & _val & FORMAT ( _prob, "0.0%" )
        & _dica & "de transbordo em até 1 hora" & _cFim
        & "</div>"

// ---------- tabela "Onde agir primeiro" ----------
VAR _base =
    ADDCOLUMNS (
        VALUES ( dim_estacao[estacao_id] ),
        "@nome", CALCULATE ( SELECTEDVALUE ( dim_estacao[nome] ) ),
        "@bairro", CALCULATE ( SELECTEDVALUE ( dim_estacao[bairro] ) ),
        "@chuva", COALESCE ( [Chuva Acumulada (mm)], 0 ),
        "@nivel", COALESCE ( [Nível Máximo (% da cota)], 0 ),
        "@prob", COALESCE ( CALCULATE ( MAX ( fato_risco[prob_transbordo_60min] ) ), 0 ),
        "@ev", COALESCE ( [Eventos de Transbordo], 0 ),
        "@al", COALESCE ( [Alertas Emitidos], 0 ),
        "@pAlerta", CALCULATE ( DIVIDE ( MAX ( dim_estacao[cota_alerta_cm] ), MAX ( dim_estacao[cota_transbordo_cm] ) ) * 100 ),
        "@pAtencao", CALCULATE ( DIVIDE ( MAX ( dim_estacao[cota_atencao_cm] ), MAX ( dim_estacao[cota_transbordo_cm] ) ) * 100 )
    )
VAR _tab = ADDCOLUMNS ( _base, "@idx", 60 * [@prob] + 0.30 * MIN ( [@nivel], 100 ) )
VAR _td = "<td style='padding:8px 10px;border-bottom:1px solid #e9edf2;vertical-align:middle'>"
VAR _tdN = "<td style='padding:8px 10px;border-bottom:1px solid #e9edf2;vertical-align:middle;text-align:right;white-space:nowrap'>"
VAR _linhas =
    CONCATENATEX (
        _tab,
        VAR n = [@nivel]
        VAR cor =
            SWITCH ( TRUE (), n >= 100, _vermelho, n >= [@pAlerta], _laranja, n >= [@pAtencao], _amarelo, _verde )
        VAR fundo =
            SWITCH ( TRUE (), n >= 100, "#fde3e0", n >= [@pAlerta], "#ffe7d6", n >= [@pAtencao], "#fff6c7", "#e2f3e7" )
        VAR rotulo =
            SWITCH ( TRUE (), n >= 100, "Transbordo", n >= [@pAlerta], "Alerta", n >= [@pAtencao], "Atenção", "Normal" )
        VAR corIdx = IF ( [@idx] >= 50, _vermelho, IF ( [@idx] >= 25, _laranja, "#14508c" ) )
        RETURN
            "<tr>"
                & _td & "<div style='font-weight:700'>" & [@nome] & "</div><div style='font-size:12px;color:#47566e'>" & [@bairro] & "</div></td>"
                & _td & "<div style='display:flex;align-items:center;gap:8px'><div style='flex:1;min-width:70px;height:10px;background:#e9edf2;border-radius:5px'>"
                & "<div style='width:" & FORMAT ( MIN ( [@idx], 100 ), "0" ) & "%;height:10px;background:" & corIdx & ";border-radius:5px'></div></div>"
                & "<b>" & FORMAT ( [@idx], "0" ) & "</b></div></td>"
                & _td & "<span style='display:inline-block;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:700;color:" & cor & ";background:" & fundo & ";border:1px solid " & cor & "'>" & rotulo & "</span></td>"
                & _td & "<div style='display:flex;align-items:center;gap:8px'><div style='flex:1;min-width:60px;height:10px;background:#e9edf2;border-radius:5px'>"
                & "<div style='width:" & FORMAT ( MIN ( n, 100 ), "0" ) & "%;height:10px;background:" & cor & ";border-radius:5px'></div></div>"
                & "<span style='white-space:nowrap'>" & FORMAT ( n, "0.0" ) & "%</span></div></td>"
                & _tdN & FORMAT ( [@prob], "0%" ) & "</td>"
                & _tdN & FORMAT ( [@chuva], "0.0" ) & " mm</td>"
                & _tdN & [@ev] & "</td>"
                & _tdN & [@al] & "</td>"
                & "</tr>",
        "",
        [@idx], DESC
    )
VAR _th = "<th style='text-align:left;padding:8px 10px;font-size:11px;font-weight:700;color:#47566e;text-transform:uppercase;letter-spacing:.03em;border-bottom:2px solid #d3dbe6'>"
VAR _thN = "<th style='text-align:right;padding:8px 10px;font-size:11px;font-weight:700;color:#47566e;text-transform:uppercase;letter-spacing:.03em;border-bottom:2px solid #d3dbe6'>"
VAR _tabela =
    "<div style='margin-top:12px;background:#ffffff;border:1px solid #d3dbe6;border-radius:14px;padding:14px 16px;box-shadow:0 1px 2px rgba(20,33,61,.08),0 6px 18px rgba(20,33,61,.06)'>"
        & "<div style='font-size:18px;font-weight:800;margin-bottom:8px'>Onde agir primeiro</div>"
        & "<table style='width:100%;border-collapse:collapse;font-size:13px'><tr>"
        & _th & "Ponto monitorado</th>" & _th & "Prioridade</th>" & _th & "Situação</th>" & _th & "Nível máx. (% da cota)</th>"
        & _thN & "Chance IA</th>" & _thN & "Chuva</th>" & _thN & "Transbordos</th>" & _thN & "Alertas</th></tr>"
        & _linhas
        & "</table>"
        & "<div style='font-size:11px;color:#47566e;margin-top:8px'>Prioridade = 60 × chance máxima da IA + 0,30 × nível máximo (até 100%). "
        & "Situação pelo nível máximo comparado às cotas de cada estação. Chuva: INMET (real). Nível dos córregos: simulado.</div></div>"

// ---------- cabeçalho (igual ao topo do app) ----------
VAR _topo =
    "<div style='background:#0b2a4a;color:#ffffff;border-bottom:3px solid #ffb000;border-radius:14px;padding:12px 18px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px'>"
        & "<div><span style='font-size:24px;font-weight:800;letter-spacing:-.01em'><span style='color:#6fd3ff'>&#128167;</span> Vig<span style='color:#6fd3ff'>IA</span></span>"
        & "<span style='font-size:15px;font-weight:600;margin-left:12px;opacity:.9'>Painel da Defesa Civil</span></div>"
        & "<div style='font-size:13px;opacity:.9'>" & _txtPeriodo & "</div></div>"

// ---------- faixa de filtros: títulos + espaços vazios onde entram as segmentações do Power BI ----------
// Os quadros brancos (Período 300 x 52 px, Estações 260 x 52 px) ficam vazios de propósito: coloque cada segmentação por cima do seu quadro.
VAR _slotRot = "<div style='font-size:12px;font-weight:700;color:#47566e;text-transform:uppercase;letter-spacing:.03em;margin-bottom:6px'>"
VAR _slotCaixa = "<div style='height:52px'></div>"
VAR _filtros =
    "<div style='margin-top:12px;background:#ffffff;border:1px solid #d3dbe6;border-radius:14px;padding:10px 16px;box-shadow:0 1px 2px rgba(20,33,61,.08),0 6px 18px rgba(20,33,61,.06);display:flex;flex-wrap:wrap;gap:16px'>"
        & "<div style='flex:0 0 300px'>" & _slotRot & "&#128197; Período</div>" & _slotCaixa & "</div>"
        & "<div style='flex:0 0 260px'>" & _slotRot & "&#128205; Estações</div>" & _slotCaixa & "</div>"
        & "</div>"

RETURN
    "<div style='font-family:""Segoe UI"",system-ui,-apple-system,Roboto,Arial,sans-serif;color:#14213d;background:#f1f4f8;padding:14px;border-radius:16px;line-height:1.4'>"
        & _topo & _filtros & _banner & _cartoes & _tabela
        & "</div>"
